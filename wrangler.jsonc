{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xiaoflow-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "mcp.xiaoflow.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "XIAOFLOW_API_URL": "https://api.xiaoflow.com"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_SESSION",
        "class_name": "McpSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["McpSession"]
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
